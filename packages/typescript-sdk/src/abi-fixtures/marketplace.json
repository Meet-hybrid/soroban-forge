{
  "schema": "soroban-forge/contract-abi@1",
  "contract": "soroban-forge-marketplace-royalties",
  "functions": [
    {
      "name": "distribute",
      "inputs": [
        {
          "name": "collection",
          "type": "address"
        },
        {
          "name": "seller",
          "type": "address"
        },
        {
          "name": "amount",
          "type": "i128"
        }
      ],
      "outputs": [
        "result<i128,udt:ForgeError>"
      ]
    },
    {
      "name": "get_royalty",
      "inputs": [
        {
          "name": "collection",
          "type": "address"
        }
      ],
      "outputs": [
        "result<udt:Royalty,udt:ForgeError>"
      ]
    },
    {
      "name": "get_settlement_summary",
      "inputs": [
        {
          "name": "collection",
          "type": "address"
        }
      ],
      "outputs": [
        "result<udt:SettlementSummary,udt:ForgeError>"
      ]
    },
    {
      "name": "set_royalty",
      "inputs": [
        {
          "name": "collection",
          "type": "address"
        },
        {
          "name": "recipient",
          "type": "address"
        },
        {
          "name": "bps",
          "type": "u32"
        }
      ],
      "outputs": [
        "result<void,udt:ForgeError>"
      ]
    },
    {
      "name": "settle_sale",
      "inputs": [
        {
          "name": "collection",
          "type": "address"
        },
        {
          "name": "token",
          "type": "address"
        },
        {
          "name": "payer",
          "type": "address"
        },
        {
          "name": "seller",
          "type": "address"
        },
        {
          "name": "amount",
          "type": "i128"
        }
      ],
      "outputs": [
        "result<udt:Settlement,udt:ForgeError>"
      ]
    }
  ],
  "events": [],
