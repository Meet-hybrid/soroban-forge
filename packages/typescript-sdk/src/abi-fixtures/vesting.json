          "value": 7
        },
        {
          "name": "InsufficientAllowance",
          "value": 8
        },
        {
          "name": "ArithmeticOverflow",
          "value": 9
        },
        {
          "name": "Custom",
          "value": 10
        },
        {
          "name": "TokenTransferFailed",
          "value": 11
        },
        {
          "name": "ContractInvocationFailed",
          "value": 12
