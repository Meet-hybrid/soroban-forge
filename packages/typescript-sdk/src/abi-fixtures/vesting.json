        {
          "name": "beneficiary_claimed",
          "type": "i128"
        },
        {
          "name": "claimed",
          "type": "i128"
        },
        {
          "name": "cliff",
          "type": "u64"
        },
        {
          "name": "duration",
          "type": "u64"
        },
        {
          "name": "funder",
          "type": "address"
        },
        {
          "name": "reassignment_count",
          "type": "u32"
        },
        {
          "name": "reassignment_vested",
          "type": "i128"
        },
        {
          "name": "revoked_vested",
          "type": "option<i128>"
        },
        {
          "name": "start",
          "type": "u64"
        },
        {
          "name": "status",
          "type": "udt:VestingStatus"
