{
  "schema": "soroban-forge/contract-abi@1",
  "contract": "soroban-forge-vesting",
  "functions": [
    {
      "name": "claim",
      "inputs": [
        {
          "name": "schedule_id",
          "type": "u64"
        }
      ],
      "outputs": [
        "result<i128,udt:ForgeError>"
      ]
    },
    {
      "name": "claim_for",
      "inputs": [
        {
          "name": "schedule_id",
          "type": "u64"
        },
        {
          "name": "beneficiary",
          "type": "address"
        }
      ],
      "outputs": [
        "result<i128,udt:ForgeError>"
      ]
    },
    {
      "name": "claimable",
      "inputs": [
        {
          "name": "schedule_id",
          "type": "u64"
        }
      ],
      "outputs": [
        "result<i128,udt:ForgeError>"
      ]
    },
    {
      "name": "claimable_for",
      "inputs": [
        {
          "name": "schedule_id",
          "type": "u64"
        },
        {
          "name": "beneficiary",
          "type": "address"
        }
      ],
      "outputs": [
        "result<i128,udt:ForgeError>"
      ]
    },
    {
      "name": "create_schedule",
      "inputs": [
        {
          "name": "funder",
          "type": "address"
        },
        {
          "name": "beneficiary",
          "type": "address"
        },
        {
          "name": "token",
          "type": "address"
        },
        {
          "name": "total_amount",
          "type": "i128"
        },
        {
          "name": "cliff",
          "type": "u64"
        },
        {
          "name": "duration",
          "type": "u64"
        }
      ],
      "outputs": [
        "result<u64,udt:ForgeError>"
      ]
    },
    {
      "name": "create_tranche_schedule",
      "inputs": [
        {
          "name": "beneficiary",
          "type": "address"
        },
        {
          "name": "token",
          "type": "address"
        },
        {
          "name": "tranches",
          "type": "vec<udt:Tranche>"
        }
      ],
      "outputs": [
        "result<u64,udt:ForgeError>"
      ]
    },
    {
      "name": "get_schedule",
      "inputs": [
        {
          "name": "schedule_id",
          "type": "u64"
        }
      ],
      "outputs": [
        "result<udt:VestingSchedule,udt:ForgeError>"
      ]
    },
    {
      "name": "get_status",
      "inputs": [
        {
          "name": "schedule_id",
          "type": "u64"
        }
      ],
      "outputs": [
        "result<udt:VestingStatus,udt:ForgeError>"
      ]
    },
    {
      "name": "get_tranche_schedule",
      "inputs": [
        {
          "name": "schedule_id",
          "type": "u64"
        }
      ],
      "outputs": [
        "result<udt:TrancheSchedule,udt:ForgeError>"
      ]
    },
    {
      "name": "reassign_beneficiary",
      "inputs": [
        {
          "name": "schedule_id",
          "type": "u64"
        },
        {
          "name": "new_beneficiary",
          "type": "address"
        }
      ],
      "outputs": [
        "result<void,udt:ForgeError>"
      ]
    },
    {
      "name": "revoke",
      "inputs": [
        {
          "name": "schedule_id",
          "type": "u64"
        }
      ],
      "outputs": [
        "result<void,udt:ForgeError>"
      ]
    }
  ],
  "events": [
    {
      "name": "BeneficiaryReassignedFrom",
      "dataFormat": "scSpecEventDataFormatMap",
      "params": [
        {
          "name": "schedule_id",
          "type": "u64"
        },
        {
          "name": "beneficiary",
          "type": "address"
        },
        {
          "name": "new_beneficiary",
          "type": "address"
        },
        {
          "name": "vested_unclaimed",
          "type": "i128"
        },
        {
          "name": "reassignment_count",
          "type": "u32"
        }
      ]
    },
    {
      "name": "BeneficiaryReassignedTo",
      "dataFormat": "scSpecEventDataFormatMap",
      "params": [
        {
          "name": "schedule_id",
          "type": "u64"
        },
        {
          "name": "beneficiary",
          "type": "address"
        },
        {
          "name": "old_beneficiary",
          "type": "address"
        },
        {
          "name": "vested_unclaimed",
          "type": "i128"
        },
        {
          "name": "reassignment_count",
          "type": "u32"
        }
      ]
    }
